{
  "name": "mzazi-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build:pages && node --test tests/portfolio.test.mjs",
    "build:pages": "tsc -b && vite build --base=/mzazimhengaportifolio/",
    "deploy": "npm run build:pages && node scripts/deploy-pages.mjs",
    "preview:pages": "vite preview --host 0.0.0.0 --base=/mzazimhengaportifolio/",
    "record:walkthrough": "npm run build:pages && node scripts/record-walkthrough.mjs"
  },
  "dependencies": {
    "motion": "^14.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "^1.56.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
